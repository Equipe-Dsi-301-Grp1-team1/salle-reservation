# Normalize line endings: LF in the repo and on checkout everywhere,
# so tests and CI behave the same on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.drawio binary
*.woff binary
*.woff2 binary
