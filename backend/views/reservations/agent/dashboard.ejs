<%- include('../partials/head', { title: title }) %>

<div class="cards">
  <% dashboard.counts.forEach(function (item) { %>
    <div class="card">
      <span class="number <%= item.status.toLowerCase() %>"><%= item.count %></span>
      <span class="label"><%= item.label %></span>
    </div>
  <% }); %>
</div>

<div class="panel">
  <h3>Revenus des 5 derniers mois</h3>
  <p>Revenus du mois en cours : <strong><%= dashboard.revenue.monthTotal.toFixed(2) %> €</strong></p>

  <% dashboard.revenue.months.forEach(function (month) { %>
    <div class="bar-line">
      <span class="bar-label"><%= month.label %></span>
      <span class="bar"><span style="width: <%= month.percent %>%"></span></span>
      <span class="bar-value"><%= month.total.toFixed(2) %> €</span>
    </div>
  <% }); %>
</div>

<div class="panel">
  <h3>Demandes en attente</h3>

  <% if (dashboard.pending.length === 0) { %>
    <p>Aucune demande en attente.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Référence</th>
          <th>Client</th>
          <th>Salle</th>
          <th>Date</th>
          <th>Montant</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% dashboard.pending.forEach(function (booking) { %>
          <tr>
            <td><%= booking.reference %></td>
            <td><%= booking.client %></td>
            <td><%= booking.room %></td>
            <td><%= booking.dateLabel %></td>
            <td><%= booking.amount.toFixed(2) %> €</td>
            <td><a href="/agent/requests/<%= booking.id %>?agentId=<%= agentId %>">Examiner</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/foot') %>
