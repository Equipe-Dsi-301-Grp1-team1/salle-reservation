<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; color: #222; background: #f7f8fc; }
    .topbar { background: #1f2937; color: white; padding: 12px 20px; display: flex; gap: 20px; align-items: center; }
    .topbar a { color: white; text-decoration: none; }
    .topbar .logo { font-weight: bold; margin-right: auto; }
    .content { max-width: 1000px; margin: 25px auto; padding: 0 15px; }
    .error { background: #fde2e2; color: #9b1c1c; padding: 10px; }
    .message { background: #def7e3; color: #1d6b2f; padding: 10px; }
    table { border-collapse: collapse; width: 100%; background: white; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 14px; }
    th { background: #eef2ff; }
    .badge { padding: 3px 8px; border-radius: 10px; font-size: 12px; white-space: nowrap; }
    .en_attente { background: #fef3c7; color: #92400e; }
    .validee { background: #dbeafe; color: #1e40af; }
    .payee { background: #d1fae5; color: #065f46; }
    .refusee { background: #fee2e2; color: #991b1b; }
    .expiree { background: #e5e7eb; color: #374151; }
    .annulee { background: #f3e8ff; color: #6b21a8; }
    .terminee { background: #e0f2fe; color: #075985; }
    .empty { background: white; padding: 20px; text-align: center; color: #555; }
    .panel { background: white; border: 1px solid #ddd; border-radius: 8px; padding: 18px; margin-bottom: 20px; }
    .panel h2 { margin-top: 0; }
    dl { display: grid; grid-template-columns: 200px 1fr; row-gap: 8px; }
    dt { font-weight: bold; }
    dd { margin: 0; }
    .filters { margin-bottom: 15px; }
    .chips { margin-bottom: 15px; }
    .chip { display: inline-block; padding: 6px 12px; margin-right: 8px; background: white; border: 1px solid #ccc; border-radius: 15px; color: #222; text-decoration: none; font-size: 14px; }
    .chip.active { background: #1f2937; color: white; border-color: #1f2937; }
    button { padding: 6px 12px; cursor: pointer; }
    button.primary { background: #1f2937; color: white; border: none; border-radius: 4px; padding: 8px 14px; }
    button.danger { background: #b91c1c; color: white; border: none; border-radius: 4px; padding: 8px 14px; }
    textarea { width: 100%; padding: 8px; box-sizing: border-box; margin: 6px 0; }
    .reject-box { margin-top: 15px; }
    .reject-box summary { cursor: pointer; color: #b91c1c; }
    form.inline { display: inline; }
  </style>
</head>
<body>
  <div class="topbar">
    <span class="logo">EventSpace</span>
    <a href="/agent/dashboard?agentId=<%= agentId %>">Tableau de bord</a>
    <a href="/agent/requests?agentId=<%= agentId %>">Demandes</a>
    <a href="/logout">Quitter</a>
  </div>
  <div class="content">
    <h1><%= title %></h1>
    <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
    <% if (typeof message !== 'undefined' && message) { %><p class="message"><%= message %></p><% } %>
